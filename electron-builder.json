{
  "appId": "com.buoyancylab.app",
  "productName": "Buoyancy Lab",
  "copyright": "Buoyancy Lab",
  "asar": true,
  "publish": null,
  "electronDist": "node_modules/electron/dist",
  "directories": {
    "output": "release/windows",
    "buildResources": "resources"
  },
  "files": [
    "desktop/**/*.cjs",
    "resources/app.ico",
    "src/project.js",
    "src/model.js",
    "src/geometry.js",
    "dist/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "LICENSE.txt",
      "to": "LICENSE.txt"
    },
    {
      "from": "docs",
      "to": "docs",
      "filter": [
        "*.md"
      ]
    },
    {
      "from": "desktop/사용 안내.txt",
      "to": "사용 안내.txt"
    },
    {
      "from": "public/THREE-LICENSE.txt",
      "to": "THREE-LICENSE.txt"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "resources/app.ico"
  },
  "nsis": {
    "artifactName": "Buoyancy-Lab-Setup-${version}.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "Buoyancy Lab",
    "installerIcon": "resources/app.ico",
    "uninstallerIcon": "resources/app.ico",
    "installerLanguages": [
      "ko_KR",
      "en_US"
    ],
    "displayLanguageSelector": false,
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false
  }
}
